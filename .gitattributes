# Auto detect text files and perform LF normalization
* text=auto

# Convention de fins de ligne du parc, voir
# admin/.claude/gitattributes-parc pour le detail et le pourquoi.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.bash text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
